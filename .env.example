# Discord Bot Token (Required)
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: Guild/Server ID - Set to 0 or leave blank to work on all servers
GUILD_ID=0

# Optional: Events Channel ID - Set to 0 or leave blank to allow events in any channel
EVENTS_CHANNEL_ID=0

# Optional: path to the seasonal themes JSON file used by /themes
# (defaults to data/themes.json in Docker, ./themes.json otherwise)
# THEMES_FILE=
# Optional: channel IDs for /themes as JSON (can also go in the themes file)
# THEME_CHANNEL_IDS={"chess":123456789,"deals":987654321}
